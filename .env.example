# Placeholder values only. Copy to .env.local and fill in; never commit real values.
# Read by src/lib/brand.ts, the web Worker, the crawler Worker and scripts/*.

# --- Site / brand (src/lib/brand.ts) ---
# Canonical public origin. Required when DEPLOYMENT_STAGE=production.
NEXT_PUBLIC_SITE_URL=https://example.com
# Runtime stage: staging | production (Workers read the wrangler var; the NEXT_PUBLIC_ twin is for non-Workers builds)
DEPLOYMENT_STAGE=staging
NEXT_PUBLIC_DEPLOYMENT_STAGE=staging
# Signup switch: true shows every newsletter form and accepts /api/subscribe; absent or anything else hides them and refuses.
# Workers read the wrangler var; set it here only for plain `next dev`.
SIGNUPS_ENABLED=false
# Optional brand overrides
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_BRAND_LOGO=
NEXT_PUBLIC_EMAIL_SOURCE_NAME=
NEXT_PUBLIC_ANALYTICS_SOURCE=
NEXT_PUBLIC_SPONSORSHIPS_ENABLED=false

# --- Cloudflare Web Analytics ---
WEB_ANALYTICS_TOKEN=your-cloudflare-web-analytics-token
WEB_ANALYTICS_HOST=example.com

# --- Kit newsletter (web Worker /api/subscribe and scripts/v2-digest.mts) ---
KIT_API_KEY=your-kit-api-key
KIT_FORM_ID=your-kit-form-id
# Public site URL used by the weekly digest links
SITE_URL=https://example.com

# --- D1 REST API (scripts/v2-refresh.mts, scripts/v2-digest.mts, d1-backup workflow) ---
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_D1_DATABASE_ID=your-d1-database-id
CLOUDFLARE_D1_API_TOKEN=your-d1-edit-token

# --- Crawler Worker (wrangler.crawler.jsonc vars) ---
CRAWLS_ENABLED=false
CRAWL_MODE=live
CRAWL_DLQ_QUEUE=your-dlq-queue-name

# --- Legacy Supabase (rollback/export only; used by /compare, scripts/audit-*.ts, scrapers:*) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

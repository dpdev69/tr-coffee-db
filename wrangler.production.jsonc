// Production web Worker. Built and deployed only by `npm run deploy:production` (docs/launch-day.md), which runs
// scripts/production-guard.mjs first: it refuses while any value starting with REPLACE_ remains, here or in the build output.
// Keep everything except the names, identifiers and vars below identical to wrangler.jsonc (tests/production-config.test.ts checks).
// NEXT_PUBLIC_SITE_URL is not written here: the deploy script passes it from the environment at build and as a runtime var.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coffeedb-v2-web",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // The miss guard runs before the app (workers/miss-guard.ts).
  "main": "workers/web.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  // The default export is the gateway (workers/web.ts): uncached, it runs on every request and stamps a fresh CSP nonce
  // on HTML. Workers Cache sits in front of App, the miss guard and the vinext app.
  "exports": {
    "default": { "type": "worker", "cache": { "enabled": false } },
    "App": { "type": "worker", "cache": { "enabled": true } }
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "account_id": "4c1a4493b8584296f35c3eddc8279112",
  // Last-good copies of catalog reads, served when D1 fails (shared/v2/last-good.ts). KV has its own free allowance.
  // No id: wrangler creates the namespace on the first deploy and reuses it after.
  "kv_namespaces": [
    {
      "binding": "LAST_GOOD"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coffeedb-v2",
      "database_id": "ff82f36e-f4e9-4b35-881b-310f3bc6271b",
      "migrations_dir": "migrations/d1"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "vars": {
    "DEPLOYMENT_STAGE": "production",
    // Signup switch: stays "false" until docs/launch-day.md "Turning on signups" is complete. Absent also means off (src/lib/signups.ts).
    "SIGNUPS_ENABLED": "false",
    "KIT_FORM_ID": "9918321",
    // Cloudflare Web Analytics site kahve.hellobasalt.dev (manual snippet, so the beacon loads only after analytics consent). Not a secret: it is in the page.
    "WEB_ANALYTICS_TOKEN": "7a0bba2437a04625a0350fb12d479748",
    // The account whose daily D1 reads the brake watches; the brake also needs the secret D1_ANALYTICS_TOKEN.
    "D1_BUDGET_ACCOUNT_ID": "4c1a4493b8584296f35c3eddc8279112",
    "WEB_ANALYTICS_HOST": "kahve.hellobasalt.dev"
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "coffeedb_v2"
    }
  ],
  "ratelimits": [
    {
      "name": "SUBSCRIBE_LIMITER",
      "namespace_id": "2001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "EVENT_LIMITER",
      "namespace_id": "2002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    // Cache misses per client per minute (workers/miss-guard.ts, docs/read-budget.md): list-sized renders, then single-coffee ones.
    {
      "name": "CATALOG_LIMITER",
      "namespace_id": "2003",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "PAGE_LIMITER",
      "namespace_id": "2004",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}

/**
 * Bundles content/bulten/YYYY-MM.md into src/app/bulten/issues.generated.ts (git-ignored).
 * Workers have no filesystem and the legacy `next build` does not support import.meta.glob, so both builds read this module.
 * Runs before dev, typecheck and every build (package.json pre-scripts). A malformed issue file fails the build with its line number.
 * Unpublished issues are left out unless --drafts is given (npm run dev passes it), so a production build cannot serve them.
 */
import { readdir, readFile, writeFile } from 'node:fs/promises';
import { resolve } from 'node:path';
import { pathToFileURL } from 'node:url';
import { ISSUE_FILE, parseIssue, type Issue } from '../src/app/bulten/issue';

export function bundleIssues(files: { name: string; raw: string }[], { drafts }: { drafts: boolean }): Issue[] {
  return files.flatMap(({ name, raw }) => {
    const month = ISSUE_FILE.exec(name)?.[1];
    if (!month) return []; // _template.md and anything else that is not an issue
    const issue = parseIssue(raw, month, `content/bulten/${name}`);
    return issue.published || drafts ? [issue] : [];
  }).sort((a, b) => b.month.localeCompare(a.month));
}

async function main() {
  const dir = resolve('content/bulten');
  const names = (await readdir(dir).catch(() => [] as string[])).filter(name => name.endsWith('.md'));
  const files = await Promise.all(names.map(async name => ({ name, raw: await readFile(resolve(dir, name), 'utf8') })));
  const issues = bundleIssues(files, { drafts: process.argv.includes('--drafts') });
  await writeFile(resolve('src/app/bulten/issues.generated.ts'), `// Generated by scripts/bulten-bundle.mts from content/bulten/*.md. Do not edit; git-ignored.
import type { Issue } from './issue';

export const issues: Issue[] = ${JSON.stringify(issues, null, 2)};
`);
  console.log(`Bülten: ${issues.length} sayı paketlendi${issues.some(issue => !issue.published) ? ' (taslaklar dahil)' : ''}.`);
}

if (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) main().catch(error => { console.error(error instanceof Error ? error.message : String(error)); process.exitCode = 1; });

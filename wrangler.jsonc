{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coffeedb-v2-web-staging",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "account_id": "4c1a4493b8584296f35c3eddc8279112",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coffeedb-v2-staging",
      "database_id": "5090f52d-546e-4ba6-bdcd-b4ee531a29a3",
      "migrations_dir": "migrations/d1"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "vars": {
    "DEPLOYMENT_STAGE": "staging",
    "KIT_FORM_ID": "9918321",
    "WEB_ANALYTICS_TOKEN": "008e6a1fb0184349ac3913e1d8c34100",
    "WEB_ANALYTICS_HOST": "coffeedb-v2-web-staging.hellobasalt.workers.dev"
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "coffeedb_v2_staging"
    }
  ],
  "ratelimits": [
    {
      "name": "SUBSCRIBE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "EVENT_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}

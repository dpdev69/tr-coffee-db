{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coffeedb-v2-crawler-staging",
  "account_id": "4c1a4493b8584296f35c3eddc8279112",
  "main": "workers/crawler.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coffeedb-v2-staging",
      "database_id": "5090f52d-546e-4ba6-bdcd-b4ee531a29a3",
      "migrations_dir": "migrations/d1"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "vars": {
    "CRAWLS_ENABLED": "false",
    "CRAWL_MODE": "live"
  },
  "triggers": {
    "crons": []
  },
  "queues": {
    "producers": [
      {
        "binding": "CRAWL_QUEUE",
        "queue": "coffeedb-v2-crawls-staging"
      }
    ],
    "consumers": [
      {
        "queue": "coffeedb-v2-crawls-staging",
        "max_batch_size": 1,
        "max_concurrency": 2,
        "max_retries": 4,
        "retry_delay": 300,
        "dead_letter_queue": "coffeedb-v2-crawls-dlq-staging"
      },
      {
        "queue": "coffeedb-v2-crawls-dlq-staging",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 10,
        "retry_delay": 300
      }
    ]
  }
}

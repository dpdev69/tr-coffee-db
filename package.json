{
  "name": "tr-coffee-db",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vinext dev --port 3001",
    "typecheck": "next typegen && tsc --noEmit",
    "scrapers:typecheck": "npm --prefix scrapers run typecheck",
    "scrapers:migrate": "npm --prefix scrapers run migrate",
    "scrapers:scrape": "npm --prefix scrapers run scrape --",
    "audit:images": "tsx scripts/audit-image-health.ts",
    "audit:metadata": "tsx scripts/audit-catalog-metadata.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm run build && npm run scrapers:typecheck",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build && node scripts/v2-sanitize-build.mjs",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "dev:cloudflare": "vinext dev --port 3001",
    "build:cloudflare": "vinext build && node scripts/v2-sanitize-build.mjs",
    "types:cloudflare": "wrangler types worker-configuration.d.ts --env-interface CloudflareEnv && wrangler types crawler-configuration.d.ts --config wrangler.crawler.jsonc --env-interface CrawlerEnv",
    "build:crawler": "wrangler deploy --config wrangler.crawler.jsonc --dry-run --outdir .local/crawler-build",
    "db:migrate:local": "wrangler d1 migrations apply coffeedb-v2-staging --local",
    "db:migrate:staging": "wrangler d1 migrations apply coffeedb-v2-staging --remote",
    "v2:export": "tsx scripts/v2-export.ts",
    "v2:quality": "tsx scripts/v2-quality.ts --write-reports",
    "dev:next": "rm -rf .next/dev && next dev ."
  },
  "dependencies": {
    "@supabase/ssr": "0.9.0",
    "@supabase/supabase-js": "2.110.2",
    "@vercel/analytics": "^2.0.1",
    "@vinext/cloudflare": "1.0.0-beta.7",
    "next": "16.2.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "three": "^0.186.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.9",
    "@tailwindcss/postcss": "^4",
    "@types/node": "22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "4.23.0",
    "typescript": "^5",
    "vite": "8.3.0",
    "wrangler": "4.131.2"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "type": "module"
}
